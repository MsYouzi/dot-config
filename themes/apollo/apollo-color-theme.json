{
  "name": "Apollo",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#11111b",
    "editor.foreground": "#cdd6f4",
    "editorCursor.foreground": "#cdd6f4",
    "editor.selectionBackground": "#313244",
    "editor.lineHighlightBackground": "#181825",
    "editorLineNumber.foreground": "#6c7086",
    "editorLineNumber.activeForeground": "#f9e2af",
    "editorWhitespace.foreground": "#313244",
    "editorIndentGuide.background1": "#181825",
    "editorIndentGuide.activeBackground1": "#313244",
    "editorBracketMatch.background": "#313244",
    "editorBracketMatch.border": "#f9e2af",
    "editor.findMatchBackground": "#f9e2af55",
    "editor.findMatchHighlightBackground": "#f9e2af33",
    "editor.wordHighlightBackground": "#31324480",
    "editor.wordHighlightStrongBackground": "#313244",
    "editorGutter.modifiedBackground": "#f9e2af",
    "editorGutter.addedBackground": "#a6e3a1",
    "editorGutter.deletedBackground": "#f38ba8",
    "editorError.foreground": "#f38ba8",
    "editorWarning.foreground": "#f9e2af",
    "editorInfo.foreground": "#89b4fa",
    "editorHint.foreground": "#94e2d5",

    "activityBar.background": "#11111b",
    "activityBar.foreground": "#bac2de",
    "activityBar.inactiveForeground": "#6c7086",
    "activityBar.activeBorder": "#f9e2af",
    "activityBarBadge.background": "#f9e2af",
    "activityBarBadge.foreground": "#11111b",

    "sideBar.background": "#11111b",
    "sideBar.foreground": "#bac2de",
    "sideBarTitle.foreground": "#cdd6f4",
    "sideBarSectionHeader.background": "#181825",
    "sideBarSectionHeader.foreground": "#cdd6f4",

    "statusBar.background": "#181825",
    "statusBar.foreground": "#bac2de",
    "statusBar.debuggingBackground": "#f5c2e7",
    "statusBar.debuggingForeground": "#cdd6f4",
    "statusBar.noFolderBackground": "#181825",
    "statusBarItem.remoteBackground": "#89b4fa",
    "statusBarItem.remoteForeground": "#cdd6f4",

    "titleBar.activeBackground": "#11111b",
    "titleBar.activeForeground": "#cdd6f4",
    "titleBar.inactiveBackground": "#11111b",
    "titleBar.inactiveForeground": "#6c7086",

    "tab.activeBackground": "#11111b",
    "tab.activeForeground": "#f9e2af",
    "tab.inactiveBackground": "#11111b",
    "tab.inactiveForeground": "#6c7086",
    "tab.activeBorderTop": "#f9e2af",
    "tab.border": "#181825",
    "editorGroupHeader.tabsBackground": "#11111b",
    "editorGroup.border": "#181825",

    "panel.background": "#11111b",
    "panel.border": "#181825",
    "panelTitle.activeForeground": "#f9e2af",
    "panelTitle.inactiveForeground": "#6c7086",

    "terminal.background": "#11111b",
    "terminal.foreground": "#cdd6f4",
    "terminalCursor.background": "#11111b",
    "terminalCursor.foreground": "#cdd6f4",
    "terminal.ansiBlack": "#45475a",
    "terminal.ansiRed": "#f38ba8",
    "terminal.ansiGreen": "#a6e3a1",
    "terminal.ansiYellow": "#f9e2af",
    "terminal.ansiBlue": "#89b4fa",
    "terminal.ansiMagenta": "#f5c2e7",
    "terminal.ansiCyan": "#94e2d5",
    "terminal.ansiWhite": "#bac2de",
    "terminal.ansiBrightBlack": "#6c7086",
    "terminal.ansiBrightRed": "#f38ba8",
    "terminal.ansiBrightGreen": "#a6e3a1",
    "terminal.ansiBrightYellow": "#f9e2af",
    "terminal.ansiBrightBlue": "#89b4fa",
    "terminal.ansiBrightMagenta": "#cba6f7",
    "terminal.ansiBrightCyan": "#94e2d5",
    "terminal.ansiBrightWhite": "#cdd6f4",

    "input.background": "#181825",
    "input.foreground": "#cdd6f4",
    "input.border": "#313244",
    "inputOption.activeBorder": "#f9e2af",
    "dropdown.background": "#181825",
    "dropdown.foreground": "#cdd6f4",
    "dropdown.border": "#313244",
    "list.activeSelectionBackground": "#313244",
    "list.activeSelectionForeground": "#f9e2af",
    "list.inactiveSelectionBackground": "#313244",
    "list.inactiveSelectionForeground": "#cdd6f4",
    "list.hoverBackground": "#181825",
    "list.focusBackground": "#313244",
    "list.highlightForeground": "#f9e2af",

    "button.background": "#89b4fa",
    "button.foreground": "#cdd6f4",
    "button.hoverBackground": "#89b4fa",

    "scrollbarSlider.background": "#31324480",
    "scrollbarSlider.hoverBackground": "#313244",
    "scrollbarSlider.activeBackground": "#6c7086",

    "badge.background": "#f9e2af",
    "badge.foreground": "#11111b",

    "diffEditor.insertedTextBackground": "#a6e3a122",
    "diffEditor.removedTextBackground": "#f38ba822",

    "gitDecoration.modifiedResourceForeground": "#f9e2af",
    "gitDecoration.deletedResourceForeground": "#f38ba8",
    "gitDecoration.untrackedResourceForeground": "#a6e3a1",
    "gitDecoration.ignoredResourceForeground": "#6c7086",
    "gitDecoration.conflictingResourceForeground": "#cba6f7",

    "peekView.border": "#f9e2af",
    "peekViewEditor.background": "#181825",
    "peekViewResult.background": "#181825",

    "notificationCenter.border": "#313244",
    "notifications.background": "#181825",
    "notifications.foreground": "#cdd6f4",

    "focusBorder": "#f9e2af",
    "foreground": "#cdd6f4"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6c7086", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#a6e3a1" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#cba6f7" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "#cdd6f4" } },
    { "scope": ["variable.language", "variable.parameter"], "settings": { "foreground": "#cdd6f4" } },
    { "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"], "settings": { "foreground": "#f38ba8" } },
    { "scope": ["keyword.operator", "punctuation.separator"], "settings": { "foreground": "#bac2de" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#f9e2af" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#f9e2af" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#94e2d5" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#f9e2af" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#bac2de" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#f9e2af", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#a6e3a1" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#f38ba8" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#f9e2af" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#f38ba8", "fontStyle": "bold" } }
  ]
}
